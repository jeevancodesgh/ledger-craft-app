# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI Configuration (for receipt scanning)
VITE_OPENAI_API_KEY=''

# E2E Testing Configuration
# These credentials are used for end-to-end testing with real user authentication
E2E_TEST_EMAIL=your_test_user_email@example.com
E2E_TEST_PASSWORD=your_test_user_password

# Email Service Configuration (Resend)
RESEND_API_KEY=your_resend_api_key

# Local Hono API + Postgres (W1 framework)
# App role — used by the API process. Never a superuser or table owner.
DATABASE_URL=postgres://ledgercraft_app:app@127.0.0.1:55432/ledgercraft
# Migrator role — drizzle migrations and test seeding only.
DATABASE_MIGRATE_URL=postgres://ledgercraft_migrator:migrator@127.0.0.1:55432/ledgercraft
# Superuser — optional local/CI bootstrap. Not used by the API.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:55432/ledgercraft
API_PORT=3001

# Note: Add your actual values to .env.local file
# The .env.local file should not be committed to version control